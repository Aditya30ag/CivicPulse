GEMINI_API_KEY=your_gemini_api_key_here
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
PORT=8000
HOST=0.0.0.0

# Custom-trained YOLO26 model checkpoint.
# Relative paths resolve against server/ first, then the project root (CWD-independent).
YOLO_MODEL_PATH=models/best.pt
# Set to false to skip the Gemini enrichment stage (severity/title/description/reasoning become null)
PERCEPTION_ENABLE_LLM_STAGE=true
